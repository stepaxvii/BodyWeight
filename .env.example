# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Database (path inside Docker container, mapped to ./data volume)
DATABASE_URL=sqlite+aiosqlite:///./data/bodyweight.db

# Mini App URL
MINI_APP_URL=https://stepaproject.ru/bodyweight

# Debug mode (enables auto-create tables, debug auth, API docs)
DEBUG=true

# --- Уведомление @bobaxvii о переезде: при старте бота один раз шлётся сообщение через OLD_BOT_TOKEN ---
# BOT_TOKEN=токен_нового_бота   # основной бот (новый API)
# OLD_BOT_TOKEN=токен_старого_бота   # только для одной отправки bobaxvii
# NEW_BOT_LINK=https://t.me/pixelfitbot
